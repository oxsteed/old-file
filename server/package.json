{
  "name": "oxsteed-v2-server",
  "version": "2.0.0",
  "description": "OxSteed v2 API server",
  "main": "index.js",
  "scripts": {
    "start": "node migrate.js && node index.js",
    "migrate": "node migrate.js",
    "dev": "nodemon index.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand",
    "test:active-job-statuses": "jest __tests__/activeJobStatuses.test.js --runInBand --forceExit",
    "test:food-e2e": "jest __tests__/foodOrderLoop.test.js --runInBand --forceExit",
    "test:food-loyalty": "jest __tests__/foodLoyalty.test.js --runInBand --forceExit",
    "test:food-promotions": "jest __tests__/foodPromotions.test.js --runInBand --forceExit",
    "verify:active-job-statuses": "node scripts/verify-active-job-statuses.js",
    "verify:credit": "node scripts/verify-oxsteed-credit.js",
    "verify:credit-concurrency": "node scripts/verify-credit-concurrency.js",
    "verify:credit-performance": "node scripts/verify-credit-performance.js",
    "verify:monitoring-capture": "node scripts/verify-monitoring-capture.js",
    "verify:monitoring-recovery": "node scripts/verify-credit-monitoring-recovery.js",
    "verify:credit-admin-api": "node scripts/verify-credit-admin-api.js",
    "verify:readiness": "node scripts/verify-readiness-payload.js",
    "verify:direct-catalog": "node scripts/verify-direct-catalog-expansion.js",
    "verify:direct-catalog-public": "node scripts/verify-direct-catalog-public-api.js",
    "verify:direct-catalog-performance": "node scripts/verify-direct-catalog-performance.js",
    "queue:replay-dead-letter": "node scripts/replay-payment-job.js",
    "verify:queue-recovery": "node scripts/verify-payment-queue-recovery.js",
    "verify:stripe-webhook-delivery": "node scripts/verify-stripe-webhook-delivery.js",
    "verify:credit-failure-injection": "node scripts/verify-credit-failure-injection.js",
    "backup:production": "bash ../scripts/backup-coolify-production.sh",
    "verify:backup-scheduler": "bash ../scripts/verify-local-backup-scheduler.sh",
    "install:backup-scheduler": "bash ../scripts/install-production-backup-launchagents.sh",
    "verify:restore": "bash ../scripts/verify-production-restore.sh",
    "verify:i18n": "node scripts/verify-server-localization.mjs",
    "translate": "node ../scripts/translate-locales.js",
    "translate:force": "node ../scripts/translate-locales.js --force"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "./__tests__/setup.js"
    ],
    "testTimeout": 15000
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1021.0",
    "@aws-sdk/s3-request-presigner": "3.1021.0",
    "@json2csv/plainjs": "^7.0.8",
    "@opentelemetry/api": "1.9.1",
    "@otplib/v12-adapter": "^13.4.0",
    "@sentry/node": "10.66.0",
    "@simplewebauthn/server": "14.0.1",
    "bcrypt": "6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "expo-server-sdk": "^3.7.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.1.0",
    "file-type": "^22.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.0",
    "multer": "2.3.0",
    "node-cron": "^4.2.1",
    "nodemailer": "9.1.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.0",
    "qrcode": "^1.5.3",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "4.8.3",
    "speakeasy": "^2.0.0",
    "stripe": "^14.0.0",
    "twilio": "^4.19.0",
    "uuid": "^14.0.0",
    "web-push": "^3.6.0"
  },
  "overrides": {
    "form-data": "4.0.6",
    "ws": "8.21.1",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
