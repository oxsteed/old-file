# OxSteed v2 Server (.env) — Production Template
#
# Copy to your production secrets store (NOT committed) and fill values.
# Required vars are enforced at boot in `server/utils/validateEnv.js`.
# Production startup also rejects placeholder, dev, and Stripe test credentials,
# including for the dedicated Credit ledger signing key.
#
# NOTE: In production, do not use localhost for any public origins.

# ── Required ───────────────────────────────────────────────────────────────
NODE_ENV=production

# 32+ chars, random
JWT_SECRET=

# PostgreSQL connection string (sslmode usually required in managed hosts)
DATABASE_URL=
# Maximum time to wait for a PostgreSQL pool connection (1-30000 ms).
DB_CONNECTION_TIMEOUT_MS=5000

# Stripe live secret key (sk_live_...)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# 32+ bytes secret used for at-rest encryption of sensitive blobs
ENCRYPTION_KEY=

# ── CORS / Networking ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins for both Express + Socket.IO.
# Example: https://oxsteed.com,https://www.oxsteed.com
CORS_ORIGINS=

# Server port (default 5000)
PORT=5000

# ── Monitoring (Sentry) ────────────────────────────────────────────────────
# DSN is safe to include in env (public), token is NOT.
SENTRY_DSN=
# Public browser DSN, passed as a Docker build argument to the Vite bundle.
VITE_SENTRY_DSN=
# Keep false unless a privacy review explicitly approves browser PII.
VITE_SENTRY_SEND_DEFAULT_PII=false
# Optional: explicit environment label (defaults to NODE_ENV/production)
SENTRY_ENVIRONMENT=production
# Suggested: set to git SHA / build id at deploy time
SENTRY_RELEASE=
# Fallback release identifier when SENTRY_RELEASE is not supplied.
COMMIT_SHA=
# Coolify predefined deployed Git commit; enable Include Source Commit in Build.
SOURCE_COMMIT=
# Disable Sentry entirely if needed (true/false). Default enabled when DSN set.
SENTRY_ENABLED=true
# Privacy: keep false unless you explicitly opt in.
SENTRY_SEND_DEFAULT_PII=false
# Tracing/profiling sampling
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0

# ── Redis (required before enabling Credit; recommended for all production) ─
REDIS_URL=

# Versioned HMAC key for the append-only OxSteed Credit journal. Keep the
# current key in the secret store and never commit a real value.
OXSTEED_CREDIT_LEDGER_HMAC_SECRET=
OXSTEED_CREDIT_LEDGER_HMAC_KEY_VERSION=v1
# During rotation, keep prior versions here until every historical entry no
# longer needs verification. Example shape: {"v1":"<old-secret>"}
OXSTEED_CREDIT_LEDGER_HMAC_KEYS_JSON=
# Optional comma-separated ISO 4217 allowlist. When empty, every currency in
# the server's verified precision map is enabled; keep this identical across replicas.
OXSTEED_CREDIT_SUPPORTED_CURRENCIES=

# Optional launch guardrails. Values are integer minor units, not always cents.
OXSTEED_CREDIT_MAX_TRANSACTION_CENTS=250000
OXSTEED_CREDIT_MAX_CUSTOMER_BALANCE_CENTS=1000000
OXSTEED_CREDIT_MAX_TOTAL_ISSUANCE_CENTS=5000000
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_ISSUANCE_CENTS=1000000
OXSTEED_CREDIT_MAX_AGREEMENT_LIMIT_CENTS=
OXSTEED_CREDIT_HOLD_TTL_MINUTES=30
OXSTEED_CREDIT_MAX_HOLD_TTL_MINUTES=1440

# Only enable customer-to-customer transfers after compliance approval.
OXSTEED_CREDIT_ALLOW_CUSTOMER_TRANSFERS=false
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_TRANSFER_CENTS=1000000
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_TRANSFER_COUNT=20
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_SPEND_CENTS=1000000
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_SPEND_COUNT=50

# Successfully delivered OxSteed Credit notification intents are retained for
# 30-730 days by the worker (default 90) for audit and support recovery.
OXSTEED_CREDIT_NOTIFICATION_RETENTION_DAYS=90

# Upload malware scanning. Leave disabled only when static validation is an
# approved temporary posture; set FILE_SCAN_REQUIRE_MALWARE=true together with
# a reachable ClamAV daemon before accepting high-risk uploads.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000
FILE_SCAN_REQUIRE_MALWARE=false

# ── Feature Flags (emergency kill switches) ────────────────────────────────
# Default behavior is ENABLED when unset; set to "false" to disable.
FEATURE_PAYMENTS_ENABLED=true
FEATURE_UPLOADS_ENABLED=true
FEATURE_CHAT_ENABLED=true

# ── Optional Integrations (feature-degrading when missing) ─────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RESEND_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SUPPORT_MODEL=gpt-4o-mini

# Optional OpenRouter fallback for server-side support triage and catalog AI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SUPPORT_MODEL=openai/gpt-4o-mini
SUPPORT_AI_TIMEOUT_MS=2500

GOOGLE_MAPS_API_KEY=

CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=

DIDIT_WEBHOOK_SECRET=

STRIPE_CONNECT_CLIENT_ID=

# ── Apple Universal Links (optional override) ──────────────────────────────
# If unset, server defaults to the known Team ID.
APPLE_TEAM_ID=ZBRGSDRRU7
