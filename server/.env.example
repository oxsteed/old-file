# OxSteed v2 Server (.env) — Production Template
#
# Copy to your production secrets store (NOT committed) and fill values.
# Required vars are enforced at boot in `server/utils/validateEnv.js`.
# Production startup also rejects placeholder, dev, and Stripe test credentials,
# including for the dedicated Credit ledger signing key.
#
# NOTE: In production, do not use localhost for any public origins.

# ── Required ───────────────────────────────────────────────────────────────
NODE_ENV=production

# 32+ chars, random. Generate with: openssl rand -hex 64.
# Keep the value stable across replicas and do not commit it.
JWT_SECRET=

# Private Coolify PostgreSQL connection string (never a placeholder or localhost in production).
# sslmode is usually required in managed hosts; use the approved private Colima setting locally.
DATABASE_URL=
# Maximum time to wait for a PostgreSQL pool connection (1-30000 ms).
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX=10

# Host-side Coolify backup runner settings. Configure BACKUP_MIRROR_ROOT for a
# mounted recovery volume separate from the local backup root.
BACKUP_ROOT=/Users/oxsteed/server-backups/production
RETENTION_DAYS=30
BACKUP_MIRROR_ROOT=

# Stripe live secret key (sk_live_...)
STRIPE_SECRET_KEY=

# Public key from the same live Stripe account, used by marketplace/mobile clients.
STRIPE_PUBLISHABLE_KEY=

# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Separate destination for events on connected accounts; never reuse the
# platform destination secret. Leave unset until its destination is configured.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Separate Identity destination (verification events, not payment events).
STRIPE_IDENTITY_WEBHOOK_SECRET=

# 32+ bytes secret used for at-rest encryption of sensitive blobs
ENCRYPTION_KEY=

# ── CORS / Networking ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins for both Express + Socket.IO.
# Example: https://oxsteed.com,https://www.oxsteed.com
CORS_ORIGINS=

# Server port (default 5000)
PORT=5000

# ── Monitoring (Sentry) ────────────────────────────────────────────────────
# DSN is safe to include in env (public), token is NOT.
SENTRY_DSN=
# Public browser DSN, passed as a Docker build argument to the Vite bundle.
VITE_SENTRY_DSN=
# Keep false unless a privacy review explicitly approves browser PII.
VITE_SENTRY_SEND_DEFAULT_PII=false
# Optional: explicit environment label (defaults to NODE_ENV/production)
SENTRY_ENVIRONMENT=production
# Suggested: set to git SHA / build id at deploy time. If all three release
# variables are blank, the Docker image generates a non-secret content release.
SENTRY_RELEASE=
# Fallback release identifier when SENTRY_RELEASE is not supplied.
COMMIT_SHA=
# Coolify predefined deployed Git commit; enable Include Source Commit in Build.
SOURCE_COMMIT=
# Disable Sentry entirely if needed (true/false). Default enabled when DSN set.
SENTRY_ENABLED=true
# Privacy: keep false unless you explicitly opt in.
SENTRY_SEND_DEFAULT_PII=false
# Tracing/profiling sampling
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0

# Optional critical security-alert destinations. Keep the Slack webhook secret
# in the deployment secret store and use only the standard HTTPS Slack endpoint.
SECURITY_ALERT_EMAIL=security@oxsteed.com
SLACK_SECURITY_WEBHOOK=

# ── Redis (required before enabling Credit; recommended for all production) ─
REDIS_URL=

# Versioned HMAC key for the append-only OxSteed Credit journal. Keep the
# current key in the secret store and never commit a real value.
OXSTEED_CREDIT_LEDGER_HMAC_SECRET=
OXSTEED_CREDIT_LEDGER_HMAC_KEY_VERSION=v1
# During rotation, keep prior versions here until every historical entry no
# longer needs verification. Example shape: {"v1":"<old-secret>"}
OXSTEED_CREDIT_LEDGER_HMAC_KEYS_JSON=
# Optional comma-separated ISO 4217 allowlist. When empty, every currency in
# the server's verified precision map is enabled; keep this identical across replicas.
OXSTEED_CREDIT_SUPPORTED_CURRENCIES=

# Optional launch guardrails. Values are integer minor units, not always cents.
OXSTEED_CREDIT_MAX_TRANSACTION_CENTS=250000
OXSTEED_CREDIT_MAX_CUSTOMER_BALANCE_CENTS=1000000
OXSTEED_CREDIT_MAX_TOTAL_ISSUANCE_CENTS=5000000
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_ISSUANCE_CENTS=1000000
OXSTEED_CREDIT_MAX_AGREEMENT_LIMIT_CENTS=
OXSTEED_CREDIT_HOLD_TTL_MINUTES=30
OXSTEED_CREDIT_MAX_HOLD_TTL_MINUTES=1440

# Only enable customer-to-customer transfers after compliance approval.
OXSTEED_CREDIT_ALLOW_CUSTOMER_TRANSFERS=false
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_TRANSFER_CENTS=1000000
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_TRANSFER_COUNT=20
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_SPEND_CENTS=1000000
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_SPEND_COUNT=50
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_CONVERSION_CENTS=1000000
OXSTEED_CREDIT_MAX_DAILY_CUSTOMER_CONVERSION_COUNT=20

# Successfully delivered OxSteed Credit notification intents are retained for
# 30-730 days by the worker (default 90) for audit and support recovery.
OXSTEED_CREDIT_NOTIFICATION_RETENTION_DAYS=90

# Automated settlement cycle (Phase 3). Runs daily at 00:05 UTC by default;
# on the configured weekday it creates a weekly cycle (previous 7 days)
# instead of the daily one. Settlements are created pending; nothing pays out.
OXSTEED_CREDIT_SETTLEMENT_CRON=5 0 * * *
OXSTEED_CREDIT_SETTLEMENT_WEEKLY_WEEKDAY=1
# Reserve monitor warning threshold: warn when a partner reserve is above
# the floor but below floor * multiplier (default 1.1 = within 10% of floor).
OXSTEED_CREDIT_RESERVE_WARN_MULTIPLIER=1.1

# Phase 5: KYC/AML/sanctions compliance perimeter for the OxSteed Credit rail.
# Tier thresholds are in minor units (cents). Tier 1 caps fiat top-ups per
# transaction; tier 2 is the rail ceiling. Sanctions screenings are re-used
# for OXSTEED_CREDIT_SANCTIONS_SCREENING_TTL_HOURS before a re-screen is
# required. Top-ups at or above OXSTEED_CREDIT_STEPUP_THRESHOLD_CENTS and
# every admin settlement payout require a fresh step-up code challenge.
# Provider keys stay empty until a real vendor is contracted.
OXSTEED_CREDIT_IDENTITY_PROVIDER=manual_review
OXSTEED_CREDIT_IDENTITY_PROVIDER_API_KEY=
OXSTEED_CREDIT_SANCTIONS_PROVIDER=manual_review
OXSTEED_CREDIT_SANCTIONS_PROVIDER_API_KEY=
OXSTEED_CREDIT_TIER1_TOPUP_MAX_CENTS=50000
OXSTEED_CREDIT_TIER2_TOPUP_MAX_CENTS=250000
OXSTEED_CREDIT_SANCTIONS_SCREENING_TTL_HOURS=24
OXSTEED_CREDIT_STEPUP_THRESHOLD_CENTS=100000
OXSTEED_CREDIT_COMPLIANCE_MONITOR_CRON=45 3 * * *

# Phase 6: money-out machinery (customer withdrawals, restaurant credit
# conversions, fee schedule). Withdrawals pay out to the customer's Stripe
# Connect account with payouts enabled; no raw bank numbers are stored.
# The same step-up threshold above applies to large withdrawals, customer
# transfers, and restaurant conversions.
OXSTEED_CREDIT_WITHDRAWAL_MIN_CENTS=100
OXSTEED_CREDIT_WITHDRAWAL_DAILY_CAP_CENTS=250000
# Fee schedule overrides (deploy-time; take precedence over the DB fee
# schedule when set). <OP> is WITHDRAWAL, TRANSFER, CONVERSION, or TOP_UP.
# Empty means the DB schedule (or zero when no row exists).
OXSTEED_CREDIT_FEE_WITHDRAWAL_FIXED_CENTS=
OXSTEED_CREDIT_FEE_WITHDRAWAL_BPS=
OXSTEED_CREDIT_FEE_WITHDRAWAL_MIN_CENTS=
OXSTEED_CREDIT_FEE_WITHDRAWAL_MAX_CENTS=
OXSTEED_CREDIT_FEE_TRANSFER_FIXED_CENTS=
OXSTEED_CREDIT_FEE_TRANSFER_BPS=
OXSTEED_CREDIT_FEE_TRANSFER_MIN_CENTS=
OXSTEED_CREDIT_FEE_TRANSFER_MAX_CENTS=
OXSTEED_CREDIT_FEE_CONVERSION_FIXED_CENTS=
OXSTEED_CREDIT_FEE_CONVERSION_BPS=
OXSTEED_CREDIT_FEE_CONVERSION_MIN_CENTS=
OXSTEED_CREDIT_FEE_CONVERSION_MAX_CENTS=
# Restaurant conversion rate (OxSteed Credit <-> restaurant food wallet),
# same-currency only. Default 1 (1:1). Must be > 0 and <= 1 so a conversion
# can never create value; the residual posts as an explicit fee leg.
OXSTEED_CREDIT_RESTAURANT_CONVERSION_RATE=1

# Upload malware scanning. Leave disabled only when static validation is an
# approved temporary posture; set FILE_SCAN_REQUIRE_MALWARE=true together with
# a reachable ClamAV daemon before accepting high-risk uploads.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000
FILE_SCAN_REQUIRE_MALWARE=false

# Browser push notifications (W3C Web Push / VAPID).
# Generate once with: node scripts/generateVapidKeys.js
# Keep the private key server-side only; the public key is returned to browsers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@oxsteed.com

# Comma-separated extra hostnames allowed for business/helper media URLs
# (logo, cover, gallery). Production hosts from S3_PUBLIC_BASE_URL, APP_URL,
# and CLIENT_URL are merged automatically; set this when media is served from
# another CDN hostname.
MEDIA_URL_ALLOWED_HOSTS=

# Media-only safety policy: cloudflare (Cloudflare CSAM Scanning Tool on cached images),
# vendor (upload-time certified vendor), or disabled. Unset defaults to cloudflare
# unless MEDIA_CSAM_CERTIFIED=true (vendor mode).
MEDIA_CSAM_MODE=
# Set true only after a validated production upload-screening vendor is live.
# Does NOT enable Cloudflare cache scanning; Cloudflare uses MEDIA_CSAM_MODE=cloudflare.
MEDIA_CSAM_CERTIFIED=
# Hostname (or https URL) of the Cloudflare-proxied origin that serves public Media
# images so they pass through the CSAM Scanning Tool cache path. Required in production
# when MEDIA_CSAM_MODE=cloudflare or public photos stay blocked.
MEDIA_CLOUDFLARE_HOST=
# Optional full public base URL for Media assets (defaults to https://MEDIA_CLOUDFLARE_HOST).
MEDIA_CLOUDFLARE_PUBLIC_BASE_URL=
# Owner override: allow public uploaded video without CSAM screening (logged at startup).
# Keep false once a certified vendor is in place. Does not disable Didit, ClamAV,
# transcode, flags, or DMCA/admin takedown.
MEDIA_PUBLIC_VIDEO_WITHOUT_CSAM=
# CI/disposable harness only. Ignored in production unless MEDIA_CSAM_CERTIFIED=true.
MEDIA_PUBLIC_VIDEO_INTERIM=
# OxSteed Media is launched with Cloudflare delivery while a certified vendor
# remains deferred (pairs with client LAUNCH_VISIBILITY).
OXSTEED_MEDIA_LAUNCHED=true

# Set to "true" to disable the server launch gate (unlaunched product APIs
# such as /api/templates and /api/marketplace/products). Leave unset in
# production; flip only for admin preview or emergency access.
LAUNCH_GATE_DISABLED=

# ── Feature Flags (emergency kill switches) ────────────────────────────────
# Default behavior is ENABLED when unset; set to "false" to disable.
FEATURE_PAYMENTS_ENABLED=true
FEATURE_UPLOADS_ENABLED=true
FEATURE_CHAT_ENABLED=true

# ── Optional Integrations (feature-degrading when missing) ─────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional dedicated IAM credentials for Amazon Location server APIs.
# Keep these separate from the storage credentials above.
AWS_LOCATION_ACCESS_KEY_ID=
AWS_LOCATION_SECRET_ACCESS_KEY=
# Opt-in Amazon Location Places v2 for /api/geo/suggest and /api/geo/reverse.
# Leave false to keep the existing Google Maps/manual fallback behavior.
AWS_GEO_PLACES_ENABLED=false
AWS_GEO_PLACES_LANGUAGE=en
# Opt-in Amazon Location Routes v2 for authenticated route estimates.
AWS_GEO_ROUTES_ENABLED=false

# Admin-triggered phone verification via AWS End User Messaging SMS.
# Keep disabled until AWS SMS origination, registration, IAM, and spend limits
# have been verified. These values are server-only and must never use VITE_.
AWS_SMS_ADMIN_VERIFICATION_ENABLED=false
AWS_SMS_REGION=us-east-1
AWS_SMS_ORIGINATION_IDENTITY=
AWS_SMS_ACCESS_KEY_ID=
AWS_SMS_SECRET_ACCESS_KEY=

RESEND_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SUPPORT_MODEL=gpt-4o-mini

# Optional OpenRouter fallback for server-side support triage and catalog AI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SUPPORT_MODEL=openrouter/free
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_TRANSLATION_MODEL=openrouter/free
OPENROUTER_APP_URL=https://oxsteed.com
OPENROUTER_APP_NAME=OxSteed
SUPPORT_AI_TIMEOUT_MS=2500

GOOGLE_MAPS_API_KEY=

CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=

DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=3d74f89a-8a9a-4a0a-a401-1501baaf2b7d
DIDIT_CALLBACK_URL=https://oxsteed.com/verify-identity
DIDIT_WEBHOOK_SECRET=

# Existing business Stripe OAuth integration consumes these exact names.
# Its configuration is separate from helper Express account onboarding.
STRIPE_CLIENT_ID=
# Optional legacy override; OAuth otherwise uses STRIPE_SECRET_KEY server-side.
STRIPE_CLIENT_SECRET=
# Register https://oxsteed.com/api/businesses/integrations/stripe/callback in Stripe.

# ── Apple Universal Links (optional override) ──────────────────────────────
# If unset, server defaults to the known Team ID.
APPLE_TEAM_ID=ZBRGSDRRU7

# Live FX rates for OxSteed Credit currency quotes (Frankfurter; no API key required).
FX_RATE_PROVIDER=frankfurter
FX_RATE_TIMEOUT_MS=8000
# Private statements: Cloudflare R2 only, separate from uploads and backups.
# Runtime-only values. Do not put these credentials into client/build variables.
# Review bucket public domains/r2.dev and bucket-scoped credentials before
# setting the attestation to 1; this is an operator gate, not automatic proof.
STATEMENT_ARTIFACT_BUCKET=
STATEMENT_ARTIFACT_PREFIX=statements
STATEMENT_R2_ENDPOINT=
STATEMENT_R2_ACCESS_KEY_ID=
STATEMENT_R2_SECRET_ACCESS_KEY=
STATEMENT_R2_PRIVACY_ATTESTED=0
STATEMENT_LEGACY_PREFIXES=

# Review W5: set true only when node workerMain.js runs as its own process.
# Unset: the API runs the scheduled workers and captures payments in-request.
DEDICATED_WORKER_PROCESS=
# Review P3-914: delete replaced uploads (queued in storage_deletion_queue) after 24h.
STORAGE_CLEANUP_ENABLED=false
# Review W4 (P3-1107): when set, every request (except health checks) must carry
# this secret in ORIGIN_SHARED_SECRET_HEADER, added by a Cloudflare transform rule.
ORIGIN_SHARED_SECRET=
ORIGIN_SHARED_SECRET_HEADER=x-origin-auth
# Review W4 (P3-940/P3-942): server-side launch gates, default off
CONSULTING_ENABLED=false
SUBSCRIPTIONS_ENABLED=false
# Review W3: hours before a helper completion request on a protected job auto-confirms (24-120).
HELPER_COMPLETION_CONFIRM_HOURS=72
# Review W2: dispute evidence window (days) shown to parties.
DISPUTE_EVIDENCE_WINDOW_DAYS=7
# Review W2: hourly refund reconciliation attempts before an attempt is terminal.
PAYMENT_REFUND_MAX_RECONCILIATION_ATTEMPTS=48
# Review W1 (P1-109, P3-814)
# Absolute refresh-session lifetime in days (rotation cannot extend past this).
SESSION_ABSOLUTE_MAX_DAYS=90
# Auto-submit staged chargeback evidence before Stripe's due date.
CHARGEBACK_AUTO_SUBMIT=true
CHARGEBACK_AUTO_SUBMIT_LEAD_HOURS=24
# ── Job editing at scale (docs/job-editing.md) ──────────────────────────────
# All optional; defaults shown.
# JOB_RECONFIRM_WINDOW_HOURS=48            # bids flagged by a material edit expire after this
# JOB_MAX_MATERIAL_EDITS_PER_DAY=5         # owner material edits per job per 24h while bids exist
# JOB_MATERIAL_NOTIFY_DEBOUNCE_SECONDS=120 # coalesce rapid edits into one bidder notice
# JOB_EDIT_NOTIFY_MAX_PER_HOUR=6           # job-edit notices per helper per hour
# JOB_EDIT_RATE_LIMIT_PER_15M=30           # PATCH/PUT /api/jobs/:id per user per 15 minutes
# JOB_EVENT_OUTBOX_RETENTION_DAYS=14       # sent/failed outbox rows kept this long
# JOB_REVISION_RETENTION_MONTHS=36         # job_revisions partitions kept (minimum 12)
# Hours a customer has to confirm a change-order re-authorization before the
# attempt expires and its card hold is released (1-144, default 24).
JOB_PAYMENT_REAUTH_TTL_HOURS=24

# ── International payment layers (docs/payment-layers.md) ────────────────────
# Every flag defaults OFF; with all of them off US behaviour is unchanged.
# FEATURE_PAYMENT_RAILS=false            # rail engine, country gates, rail switching, offline ack
# FEATURE_RAIL_STRIPE_INTL=false         # non-US Express accounts, destination charges, non-USD
# FEATURE_STRIPE_LOCAL_METHODS=false     # charge-now local methods (country legal flag also needed)
# FEATURE_PLATFORM_HOLD=false            # charge now + hold on platform (>5-day jobs, local methods)
# FEATURE_RAIL_CREDIT=false              # OxSteed Credit as payment / collateral
# FEATURE_CREDIT_CASHOUT=false           # Credit cash-out through licensed partners
# FEATURE_RAIL_OFFLINE_GATING=false      # offline: subscription + verified helper + first-job cap
# FEATURE_COUNTRY_FEES=false             # per-country fee schedule + Credit discount
# FEATURE_JOB_TIPS=false                 # tips (processing cost only, no platform fee)
# FEATURE_CONTACT_MASKING=false          # hide contact details before a hire
# FEATURE_HOLD_EXPIRY_REAUTH=false       # flag card holds for renewal before they expire
# FEATURE_PRIVACY_RETENTION=false        # erasure requests + retention sweep
# FEATURE_LOCALIZED_NOTIFICATIONS=false  # notifications in the recipient's language
# FEATURE_COUNTRY_SMS=false              # E.164 numbers + per-country SMS sender
# FEATURE_JOB_TIMEZONES=false            # store the job time zone at creation
# JOB_HOLD_REAUTH_LEAD_HOURS=36          # flag a card hold this long before it expires
# CREDIT_AUTO_RELEASE_HOURS=72           # Credit payment released to the helper after completion
# Per-country SMS senders (used when FEATURE_COUNTRY_SMS is on), e.g.:
# TWILIO_MESSAGING_SERVICE_SID=          # default messaging service
# TWILIO_MESSAGING_SERVICE_SID_GB=
# TWILIO_FROM_KE=                        # alphanumeric sender ID or number
# TWILIO_FROM_HT=
# Cash-out partners (stubs until a real adapter ships; never invent values):
# MPESA_B2C_CONSUMER_KEY= MPESA_B2C_CONSUMER_SECRET= MPESA_B2C_SHORTCODE=
# MPESA_B2C_INITIATOR_NAME= MPESA_B2C_SECURITY_CREDENTIAL= MPESA_B2C_RESULT_URL=
# MONCASH_CLIENT_ID= MONCASH_CLIENT_SECRET= MONCASH_BUSINESS_KEY=
# WISE_API_TOKEN= WISE_PROFILE_ID= WISE_WEBHOOK_PUBLIC_KEY=

# ── Analytics platform ───────────────────────────────────────────────────────
# Metric threshold alert evaluator (runs every 60s). Set to false to disable.
METRIC_ALERTS_ENABLED=true
# Days of alert observations / fires / settled SMS claims kept (30-3650).
METRIC_ALERT_HISTORY_RETENTION_DAYS=400
# Optional model fallback for the admin natural-language query parser. Keep
# false until the provider, privacy and acceptance review is complete.
ANALYTICS_NL_MODEL_ENABLED=false
