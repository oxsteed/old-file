# OxSteed v2 Server (.env) — Production Template
#
# Copy to your production secrets store (NOT committed) and fill values.
# Required vars are enforced at boot in `server/utils/validateEnv.js`.
#
# NOTE: In production, do not use localhost for any public origins.

# ── Required ───────────────────────────────────────────────────────────────
NODE_ENV=production

# 32+ chars, random
JWT_SECRET=

# PostgreSQL connection string (sslmode usually required in managed hosts)
DATABASE_URL=

# Stripe live secret key (sk_live_...)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# 32+ bytes secret used for at-rest encryption of sensitive blobs
ENCRYPTION_KEY=

# ── CORS / Networking ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins for both Express + Socket.IO.
# Example: https://oxsteed.com,https://www.oxsteed.com
CORS_ORIGINS=

# Server port (default 5000)
PORT=5000

# ── Monitoring (Sentry) ────────────────────────────────────────────────────
# DSN is safe to include in env (public), token is NOT.
SENTRY_DSN=
# Optional: explicit environment label (defaults to NODE_ENV/production)
SENTRY_ENVIRONMENT=production
# Suggested: set to git SHA / build id at deploy time
SENTRY_RELEASE=
# Disable Sentry entirely if needed (true/false). Default enabled when DSN set.
SENTRY_ENABLED=true
# Privacy: keep false unless you explicitly opt in.
SENTRY_SEND_DEFAULT_PII=false
# Tracing/profiling sampling
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0

# ── Redis (optional but recommended for multi-instance rate limiting) ──────
REDIS_URL=

# Successfully delivered OxSteed Credit notification intents are retained for
# 30-730 days by the worker (default 90) for audit and support recovery.
OXSTEED_CREDIT_NOTIFICATION_RETENTION_DAYS=90

# ── Feature Flags (emergency kill switches) ────────────────────────────────
# Default behavior is ENABLED when unset; set to "false" to disable.
FEATURE_PAYMENTS_ENABLED=true
FEATURE_UPLOADS_ENABLED=true
FEATURE_CHAT_ENABLED=true

# ── Optional Integrations (feature-degrading when missing) ─────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RESEND_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SUPPORT_MODEL=gpt-4o-mini

# Optional OpenRouter fallback for server-side support triage and catalog AI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SUPPORT_MODEL=openai/gpt-4o-mini
SUPPORT_AI_TIMEOUT_MS=2500

GOOGLE_MAPS_API_KEY=

CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=

DIDIT_WEBHOOK_SECRET=

STRIPE_CONNECT_CLIENT_ID=

# ── Apple Universal Links (optional override) ──────────────────────────────
# If unset, server defaults to the known Team ID.
APPLE_TEAM_ID=ZBRGSDRRU7
