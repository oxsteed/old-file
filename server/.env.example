# OxSteed Server Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================================================
# REQUIRED - Server will exit if missing
# ============================================================================

# Authentication JWT secret (min 32 chars, use: openssl rand -base64 32)
JWT_SECRET=your-secret-key-min-32-characters-long

# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/oxsteed_db

# Stripe API keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Encryption key for sensitive data (exactly 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-string

# ============================================================================
# OPTIONAL - Features degrade gracefully if missing
# ============================================================================

# File storage (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Email sending
RESEND_API_KEY=

# SMS/OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Identity verification
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# Background checks
CHECKR_API_KEY=

# AI Chat
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Translation platform (server/modules/translation)
# Provider chain — default is openrouter -> openai -> libretranslate. Each
# unconfigured provider (no API key / no URL) is silently skipped. Override
# the head of the chain by setting TRANSLATION_PRIMARY_PROVIDER, append
# additional fallbacks with TRANSLATION_FALLBACK_PROVIDERS (comma-separated),
# or force a single provider via TRANSLATION_PROVIDER (legacy single-mode).
TRANSLATION_PRIMARY_PROVIDER=openrouter
TRANSLATION_FALLBACK_PROVIDERS=openai,libretranslate
# TRANSLATION_PROVIDER=

# OpenRouter model + per-request budget (uses OPENROUTER_API_KEY above)
OPENROUTER_TRANSLATION_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=

# OpenAI direct fallback (uses OPENAI_API_KEY above)
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000
OPENAI_ORG_ID=

# Self-hosted LibreTranslate fallback (optional)
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_MODEL_NAME=libretranslate-default

# Bump this to invalidate the entire translation cache without flushing Redis
# (e.g. when prompt template or default model changes). Part of the cache key.
TRANSLATION_MODEL_POLICY_VERSION=policy-v1

# Translation batch-job worker poll cadence (6-field cron, seconds first).
TRANSLATION_JOB_POLL_CRON=*/30 * * * * *

# ─── Admin/Operations/Compliance access gate (migrations 276/277/278) ────
# These tune the rate limiter that protects the (name + security key) gate
# at /admin/login, /logistics/operations/gate, /logistics/compliance/gate.
ACCESS_GATE_MAX_FAILS=3
ACCESS_GATE_LOCKOUT_HOURS=24
# Comma-separated emails that may trigger a recovery email when a super-admin
# locks themselves out. Leave empty to disable the email recovery path
# (CLI recovery via server/scripts/resetAccessGateLockouts.js still works).
ACCESS_GATE_RECOVERY_EMAILS=

# Maps/Geolocation
GOOGLE_MAPS_API_KEY=

# Stripe Connect
STRIPE_CONNECT_CLIENT_ID=

# Distributed rate limiting (falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# Web Push Notifications (optional)
VAPID_SUBJECT=mailto:support@yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Server port
PORT=5000

# Node environment (production|development)
NODE_ENV=development

# Logging level (debug|info|warn|error)
LOG_LEVEL=debug

# Client URLs (for CORS, password reset links, etc)
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:5000

# Payment capture mode (sync|async)
# PRODUCTION: set to true so payment capture doesn't block response threads under load
PAYMENT_CAPTURE_ASYNC=false

# Database connection pool size
# PRODUCTION: set based on (Postgres max_connections / number of server instances)
# e.g. Postgres max_connections=100, 2 instances → DB_POOL_MAX=45 (leave headroom for admin)
DB_POOL_MAX=10

# ============================================================================
# OPTIONAL: Analytics & Monitoring
# ============================================================================

# Sentry (error tracking)
SENTRY_DSN=

# Google Analytics (frontend, set in client .env)
VITE_GA_MEASUREMENT_ID=

# Meta Pixel (frontend, set in client .env)
VITE_META_PIXEL_ID=
