{
  "$id": "account.signed_up.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": {
      "enum": [
        "customer",
        "helper",
        "business",
        "restaurant",
        "broker"
      ]
    },
    "tier": {
      "enum": [
        "starter",
        "pro",
        "elite"
      ]
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    }
  }
}
