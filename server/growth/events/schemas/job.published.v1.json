      "maxLength": 36
    },
    "category_id": {
      "type": "integer",
      "minimum": 1
    },
    "job_type": {
      "type": "string",
      "pattern": "^[a-z_]{1,50}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "postal_ref": {
      "type": "integer",
      "minimum": 1
    }
  }
}
