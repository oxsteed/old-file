# OxSteed Client Configuration
# Copy this file to .env.local and fill in your values

# ============================================================================
# API Configuration
# ============================================================================

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Public site URL (for OG tags, canonical URLs, sitemap)
VITE_PUBLIC_SITE_URL=http://localhost:5000

# ============================================================================
# OPTIONAL: Analytics (Consent-Gated)
# ============================================================================

# Google Analytics 4 Measurement ID
# These scripts will NOT load until user accepts analytics cookies
VITE_GA_MEASUREMENT_ID=

# Meta Pixel ID
VITE_META_PIXEL_ID=

# ============================================================================
# OPTIONAL: Feature Flags
# ============================================================================

# Enable web push notifications
VITE_ENABLE_WEB_PUSH=true

# Enable Didit identity verification
VITE_DIDIT_ENABLED=true

# ============================================================================
# Development Settings
# ============================================================================

# Enable React DevTools in production (false recommended)
VITE_ENABLE_DEVTOOLS=false

# Enable detailed logging
VITE_DEBUG_LOGS=false
