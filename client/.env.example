# Optional: canonical site URL for SEO meta (canonical, og:url) when the app is built
# without access to window (SSR not used). Example: https://oxsteed.com
# If unset, the browser uses window.location.origin at runtime.
VITE_PUBLIC_SITE_URL=

# Sentry error tracking DSN (from sentry.io > oxsteed-frontend project > Client Keys)
VITE_SENTRY_DSN=
# Optional: release label in Sentry (e.g. git SHA or app version)
# VITE_APP_VERSION=1.0.0
# Match Sentry wizard default PII (IP, etc.) — default in code is false when unset
# VITE_SENTRY_SEND_DEFAULT_PII=true

# Optional CI / release: upload source maps (@sentry/vite-plugin when all three set at build time)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
