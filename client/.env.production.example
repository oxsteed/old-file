# OxSteed Web Client (Vite) — Production Template
#
# These are build-time variables used by Vite. Configure in your CI/CD
# environment (do not commit filled secrets).

# API base URL (recommended: your production API origin + /api)
VITE_API_URL=https://oxsteed.com/api

# Canonical public site origin (used for SEO canonical tags)
VITE_PUBLIC_SITE_URL=https://oxsteed.com

# Stripe publishable key (pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# Sentry (browser)
VITE_SENTRY_DSN=
VITE_SENTRY_SEND_DEFAULT_PII=false
# Release identifier visible in Sentry (e.g. 1.0.0+121 or git SHA)
VITE_APP_VERSION=

# Optional analytics/consent integrations
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# ── Sentry sourcemap upload (CI only; NOT exposed to the browser) ──────────
# Used by `@sentry/vite-plugin` during `vite build` only.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

