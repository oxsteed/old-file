{
  "name": "oxsteed-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "test:credit-currency": "node --test scripts/creditCurrency.test.mjs",
    "test:credit-date-time": "node --test scripts/creditDateTime.test.mjs",
    "test:credit-admin-idempotency": "node --test scripts/creditAdminIdempotency.test.mjs",
    "test:credit-request-guards": "node --test scripts/creditRequestGuards.test.mjs",
    "test:credit-status": "node --test scripts/creditStatus.test.mjs",
    "test:credit-errors": "node --test scripts/creditErrors.test.mjs",
    "test:auth-refresh-policy": "node --test scripts/authRefreshPolicy.test.mjs",
    "test:realtime-url": "node --test scripts/realtimeUrl.test.mjs",
    "test:restaurant-discovery": "node --test scripts/restaurantDiscovery.test.mjs",
    "test:restaurant-accessibility": "node --test scripts/restaurantAccessibility.test.mjs",
    "test:business-profile-editor": "node --test scripts/businessProfileEditor.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:ci": "npm run test:credit-currency && npm run test:credit-date-time && npm run test:credit-admin-idempotency && npm run test:credit-request-guards && npm run test:credit-status && npm run test:credit-errors && npm run test:auth-refresh-policy && npm run test:realtime-url && npm run test:restaurant-discovery && npm run test:restaurant-accessibility && npm run test:business-profile-editor && npm run verify:i18n && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@sentry/react": "^8.55.1",
    "@simplewebauthn/browser": "14.0.0",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.3.1",
    "@tanstack/react-query": "^5.28.0",
    "axios": "^1.20.0",
    "date-fns": "^3.3.1",
    "i18next": "^26.0.5",
    "i18next-http-backend": "^3.0.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "qr-code-styling": "^1.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^17.0.3",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "use-debounce": "^10.0.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^2.23.1",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "5.2.0",
    "acorn": "^8.16.0",
    "acorn-jsx": "^5.3.2",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.0",
    "vite": "6.4.3"
  }
