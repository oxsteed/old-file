{
  "expo": {
    "name": "OxSteed",
    "slug": "oxsteed",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "oxsteed",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.oxsteed.app",
      "buildNumber": "105",
      "supportsTablet": true,
      "associatedDomains": ["applinks:oxsteed.com", "applinks:www.oxsteed.com"]
    },
    "android": {
      "package": "com.oxsteed.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "oxsteed.com" },
            { "scheme": "https", "host": "www.oxsteed.com" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "@sentry/react-native/expo",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow OxSteed to add confirmed bookings and appointments to your calendar."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://oxsteed.com/api",
      "sentryDsn": ""
    }
  }
}
